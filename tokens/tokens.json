{
  "name": "PujaPrem Design Tokens",
  "version": "0.1.1",
  "format": "pujaprem-semantic-tokens",
  "direction": "modern Indian devotional minimalism with warm editorial ecommerce",
  "color": {
    "brand": {
      "maroon": "#5A1832",
      "saffron": "#F59E0B",
      "ivory": "#FFF8E7",
      "charcoal": "#201A17",
      "green": "#2E6E50",
      "clay": "#A33A17"
    },
    "semantic": {
      "background": "#FFF8E7",
      "surface": "#FFFFFF",
      "surfaceWarm": "#FBF1DC",
      "surfaceMuted": "#F5E9D2",
      "text": "#201A17",
      "textMuted": "#675D57",
      "border": "#E3D4BD",
      "primary": "#5A1832",
      "primaryText": "#FFFFFF",
      "accent": "#F59E0B",
      "trust": "#2E6E50",
      "warmAccent": "#A33A17",
      "focus": "#2E6E50",
      "success": "#2E6E50",
      "warning": "#9A5A00",
      "danger": "#A12622"
    }
  },
  "typography": {
    "family": {
      "display": "Poppins, ui-sans-serif, system-ui, sans-serif",
      "body": "Inter, ui-sans-serif, system-ui, sans-serif"
    },
    "size": {
      "xs": "clamp(0.75rem, 0.72rem + 0.1vw, 0.8125rem)",
      "sm": "clamp(0.875rem, 0.84rem + 0.12vw, 0.9375rem)",
      "md": "clamp(1rem, 0.95rem + 0.18vw, 1.125rem)",
      "lg": "clamp(1.125rem, 1.02rem + 0.32vw, 1.375rem)",
      "xl": "clamp(1.375rem, 1.15rem + 0.75vw, 1.875rem)",
      "2xl": "clamp(1.75rem, 1.35rem + 1.25vw, 2.5rem)",
      "3xl": "clamp(2.25rem, 1.55rem + 2.1vw, 3.75rem)",
      "display": "clamp(3rem, 1.8rem + 4vw, 6rem)"
    },
    "lineHeight": {
      "tight": 1.05,
      "heading": 1.15,
      "body": 1.6
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "clamp(2rem, 1.4rem + 2vw, 3rem)",
    "8": "clamp(3rem, 2rem + 3vw, 4rem)",
    "9": "clamp(4rem, 2.5rem + 5vw, 6rem)"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "24px",
    "pill": "999px"
  },
  "border": {
    "width": "1px",
    "color": "#E3D4BD"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(32, 26, 23, 0.06)",
    "md": "0 8px 24px rgba(66, 42, 32, 0.08)",
    "lg": "0 18px 48px rgba(66, 42, 32, 0.14)"
  },
  "motion": {
    "fast": "140ms",
    "standard": "220ms",
    "drawer": "280ms",
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "control": {
    "minHeight": "44px",
    "focusRing": "0 0 0 3px rgba(46, 110, 80, 0.28)"
  },
  "layout": {
    "contentMax": "1200px",
    "readingMax": "720px",
    "gutter": "clamp(1rem, 0.5rem + 2vw, 2rem)"
  },
  "breakpoint": {
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  }
}
